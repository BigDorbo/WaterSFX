<Defs>

  <SoundDef>
    <defName>WaterSFX_Coast</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>true</onCamera>
        <muteWhenPaused>true</muteWhenPaused>
        <volumeRange>36~36</volumeRange>
        <pitchRange>0.93~1.07</pitchRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_AmbientVolume" />
            <outParam Class="SoundParamTarget_Volume" />
          </li>
          <li>
            <inParam Class="SoundParamSource_External">
              <inParamName>Vol</inParamName>
            </inParam>
            <outParam Class="SoundParamTarget_Volume" />
          </li>
        </paramMappings>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>WaterSFX/water_coast</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>

